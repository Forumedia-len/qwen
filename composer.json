{
  "name": "active-court/application",
  "description": "Active Court application development tools",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://git.forumedia.eu/ActiveCourt/ac_tests.git",
      "canonical": true
    }
  ],
  "require": {
    "php": "~8.2.0"
  },
  "require-dev": {
